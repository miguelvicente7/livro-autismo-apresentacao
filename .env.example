# Runtime do container no Coolify (Dockerfile na raiz, porta 4500)
NODE_ENV=production
PORT=4500
HOSTNAME=0.0.0.0
TZ=America/Sao_Paulo

# Base da API do CMS ControleEstoque (sem barra no final) — obrigatória para login/registro
# Local: apps/cms-backend em http://127.0.0.1:4848
CMS_API_URL=http://127.0.0.1:4848

# API key do site (Bearer) com scopes auth:login e auth:register
CMS_API_KEY=

# Paths relativos à CMS_API_URL
CMS_LOGIN_PATH=/api/v1/auth/login
CMS_REGISTER_PATH=/api/v1/auth/register
CMS_ME_PATH=/api/v1/auth/session

# Cookie httpOnly da sessão no Next.js
AUTH_COOKIE_NAME=livro_session

# true = só HTTPS | false = permite HTTP (Docker/local sem TLS)
# Se omitir: true quando NODE_ENV=production
AUTH_COOKIE_SECURE=false
