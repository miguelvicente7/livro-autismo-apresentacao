# Runtime do container no Coolify (Dockerfile na raiz, porta 4500)
NODE_ENV=production
PORT=4500
HOSTNAME=0.0.0.0
TZ=America/Sao_Paulo

# Base da API do CMS (sem barra no final) — obrigatória para login/registro
CMS_API_URL=https://seu-cms.exemplo.com/api

# Paths relativos à CMS_API_URL
CMS_LOGIN_PATH=/auth/login
CMS_REGISTER_PATH=/auth/register
CMS_ME_PATH=/auth/me

# Cookie httpOnly da sessão no Next.js
AUTH_COOKIE_NAME=livro_session

# true = só HTTPS | false = permite HTTP (Docker/local sem TLS)
# Se omitir: true quando NODE_ENV=production
AUTH_COOKIE_SECURE=false
